VITE_BACKEND_URL=https://kicad.vps.keyboard-tools.xyz

# Optional user accounts (GitHub sign-in via Supabase).
# Accounts stay disabled until BOTH variables have values: every account feature stays
# hidden and supabase-js is never loaded, so the editor behaves exactly as it does
# without them.
# The anon key is public by design: it identifies the project and grants nothing on its
# own, because row level security is the security boundary. Never put the service-role
# key in this file.
VITE_SUPABASE_URL=https://cdcvedgnkamejhhowach.supabase.co
# Project Settings -> API -> anon / public key (newer dashboards: "publishable key")
VITE_SUPABASE_ANON_KEY=sb_publishable_fSe7oq3k5-Vi9ZQVOtMaOg_Eoelb8wk

# Note: Create a .env.local file (gitignored) with your actual configuration
# The VITE_ prefix is required for Vite to expose these to the client
