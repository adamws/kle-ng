# Local development configuration — copy to .env.local:
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored (the `*.local` rule) and overrides .env.production, so a
# checkout set up this way never talks to the live project. Nothing here is secret.

# Backend API URL for the PCB generator — leave unset to use the Vite proxy, which
# forwards /api/* to http://localhost:8080 (see vite.config.ts) and avoids CORS.
#VITE_BACKEND_URL=

# ---------------------------------------------------------------------------
# Supabase — optional user accounts, pointed at the LOCAL stack.
#
#   npm run supabase:start     # boots Postgres + Auth + Studio in Docker
#   npm run supabase:status    # prints the URL and keys again
#
# Accounts stay disabled until BOTH variables have values, so a half-configured
# checkout simply behaves as it does without accounts. The anon/publishable key
# below is the fixed one a stock local stack issues; if `supabase:start` prints a
# different one, paste that instead. It grants nothing on its own — row level
# security is the boundary — and this is a disposable local database either way.
#
# Delete both lines to develop with accounts off.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
